generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoVoluntario {
  admin
  supervisor
  atendente
}

enum Periodo {
  manha
  tarde
  noite
  integral
  online
}


model Produto {
  idProduto         Int     @id @default(autoincrement())
  nomeProduto       String  @db.VarChar(50)
  precoProduto      Decimal @db.Decimal(5, 2)
  quantidadeProduto Int
  tipoProduto       String  @db.VarChar(20)
  statusItem        String  @db.VarChar(20)

  itensCompra ItemCompra[]
}

model Compra {
  idCompra       Int      @id @default(autoincrement())
  codVoluntario  Int
  codAluno       Int
  valorCompra    Decimal  @db.Decimal(6, 2)
  dataHoraCompra DateTime
  codigoRetirada String   @db.VarChar(100)

  aluno         Aluno          @relation(fields: [codAluno], references: [idAluno])
  voluntario    Voluntario     @relation(fields: [codVoluntario], references: [idVoluntario])
  itensCompra   ItemCompra[]
  pagamentos    Pagamento[]
  contribuicoes Contribuicao[]
}

model ItemCompra {
  codProduto             Int
  codCompra              Int
  precoUnitario          Decimal @db.Decimal(5, 2)
  quantidadeItem         Int
  quantidadeRetiradaItem Int
  statusItem             String  @db.VarChar(20)

  produto Produto @relation(fields: [codProduto], references: [idProduto])
  compra  Compra  @relation(fields: [codCompra], references: [idCompra])

  @@id([codProduto, codCompra])
}

model Pagamento {
  idPagamento    Int     @id @default(autoincrement())
  codCompra      Int
  valorPagamento Decimal @db.Decimal(6, 2)
  tipoPagamento  String  @db.VarChar(30)

  compra Compra @relation(fields: [codCompra], references: [idCompra])
}

model Contribuicao {
  idContribuicao    Int      @id @default(autoincrement())
  codCompra         Int
  valorContribuicao Decimal  @db.Decimal(6, 2)
  dataHora          DateTime

  compra Compra @relation(fields: [codCompra], references: [idCompra])
}

model Curso {
  idCurso   Int     @id @default(autoincrement())
  nomeCurso String  @db.VarChar(100)
  arquivado Boolean @default(false)

  periodos PeriodoCurso[]
  cursosAluno CursoAluno[]
}

model PeriodoCurso {
  idPeriodo        Int          @id @default(autoincrement())
  codCurso         Int
  periodo          Periodo
  vagasTotais      Int
  matriculaAtiva   Boolean      @default(true)

  curso            Curso        @relation(fields: [codCurso], references: [idCurso])

  @@unique([codCurso, periodo])
}

model Aluno {
  idAluno   Int    @id @default(autoincrement()) 
  cpfAluno  String @db.VarChar(15)
  anoAluno  Int
  nomeAluno String @db.VarChar(100)

  compras     Compra[]
  cursosAluno CursoAluno[]
  senhas      Senha[]
}

model CursoAluno {
  codCurso  Int
  codAluno  Int

  curso Curso @relation(fields: [codCurso], references: [idCurso])
  aluno Aluno @relation(fields: [codAluno], references: [idAluno])

  @@id([codCurso, codAluno])
}

model Senha {
  idSenha             Int       @id @default(autoincrement())
  codAluno            Int?
  senhaCodigo         Int    
  dataHoraInicioSenha DateTime
  dataHoraFimSenha    DateTime?
  etapaSenha          String    @db.VarChar(15)
  tipoSenha           Boolean   @default(false)
  statusSenha         String    @db.VarChar(20)

  aluno      Aluno?           @relation(fields: [codAluno], references: [idAluno])
  historicos HistoricoSenha[]
}

model Voluntario {
  idVoluntario     Int            @id @default(autoincrement())
  nomeVoluntario   String         @db.VarChar(100)
  senhaVoluntario  String         @db.VarChar(50)
  tipoVoluntario   TipoVoluntario @default(admin)
  statusVoluntario String         @db.VarChar(20)

  compras    Compra[]
  historicos HistoricoSenha[]
}

model HistoricoSenha {
  idHistorico             Int       @id @default(autoincrement())
  codSenha                Int
  codVoluntario           Int
  etapaHistorico          String?   @db.VarChar(15)
  dataHoraInicioHistorico DateTime
  dataHoraFimHistorico    DateTime?

  senha      Senha      @relation(fields: [codSenha], references: [idSenha])
  voluntario Voluntario @relation(fields: [codVoluntario], references: [idVoluntario])
}
